        </div>

        <!-- 戰場區域 -->
        <div class="battle-stage">
            <div class="cannonball" id="cannonball"></div>
            
            <!-- 爆炸特效 SVG (P1 被擊中) -->
            <div class="explosion-effect explosion-p1" id="explosion-p1">
                <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <path d="M50 5 L60 35 L95 25 L70 50 L95 75 L60 65 L50 95 L40 65 L5 75 L30 50 L5 25 L40 35 Z" fill="#ef4444" stroke="#fbbf24" stroke-width="4"/>
                    <path d="M50 20 L57 40 L80 33 L63 50 L80 67 L57 60 L50 80 L43 60 L20 67 L37 50 L20 33 L43 40 Z" fill="#fbbf24"/>
                </svg>
            </div>

            <!-- 爆炸特效 SVG (P2 被擊中) -->
            <div class="explosion-effect explosion-p2" id="explosion-p2">
                <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <path d="M50 5 L60 35 L95 25 L70 50 L95 75 L60 65 L50 95 L40 65 L5 75 L30 50 L5 25 L40 35 Z" fill="#ef4444" stroke="#fbbf24" stroke-width="4"/>
                    <path d="M50 20 L57 40 L80 33 L63 50 L80 67 L57 60 L50 80 L43 60 L20 67 L37 50 L20 33 L43 40 Z" fill="#fbbf24"/>
                </svg>
            </div>

            <!-- 草帽海賊團 (千陽號 SVG 風格) -->
            <div class="ship-wrapper p1-ship-wrap" id="p1-ship">
