        <div class="question-box" id="question">12 ÷ 4 = ?</div>

        <!-- 雙人獨立對戰控制區 -->
        <div class="pvp-controls">
            <!-- 玩家 A：魯夫 (草帽海賊團) -->
            <div class="player-panel p1">
                <div class="player-title">👒 魯夫 (草帽隊)</div>
                <input type="number" id="p1-input" step="any" placeholder="輸入答案" autocomplete="off" onkeydown="if(event.key==='Enter') submitAnswer(1)">
                <button class="btn-fire btn-p1" id="p1-btn" onclick="submitAnswer(1)">🔥 橡膠橡膠大砲！</button>
            </div>
            
            <!-- 玩家 B：凱多 (百獸海賊團) -->
            <div class="player-panel p2">
                <div class="player-title">🐉 凱多 (百獸隊)</div>
                <input type="number" id="p2-input" step="any" placeholder="輸入答案" autocomplete="off" onkeydown="if(event.key==='Enter') submitAnswer(2)">
                <button class="btn-fire btn-p2" id="p2-btn" onclick="submitAnswer(2)">⚡ 熱息威力轟炸！</button>
            </div>
        </div>

        <div class="message" id="message"></div>
    </div>

    <!-- 遊戲結束：海賊王誕生畫面 -->
    <div id="game-over-screen" class="game-over">
        <h2 id="winner-title" style="font-size: 2.5em; color: #b45309; margin-bottom: 5px;">🎉 偉大航道新霸主誕生！</h2>
        <div class="bounty-tag" id="bounty-text">懸賞金：฿ 3,000,000,000</div>
        <div style="font-size: 5em; margin: 15px 0;">👑🏴‍☠️🍖</div>
        <button class="btn-fire btn-p1" style="width: 260px; font-size: 1.5em; background: #b45309; box-shadow: 0 5px 0 #78350f;" onclick="restartGame()">🔄 再次挑戰偉大航道</button>
    </div>
</div>

<script>
    let currentAnswer = 0;
    let p1Hp = 5;
    let p2Hp = 5;
    let isRoundActive = true;

    // 嚴格可整除小數題目生成
    function generateQuestion() {
        const type = Math.floor(Math.random() * 5);
        let num1, num2, answer;
        let typeName = "";

        switch (type) {
            case 0:
                typeName = "🗺️ 航線 1：整數 ÷ 整數";
                const d0 = [2, 4, 5, 8, 10];
                num2 = d0[Math.floor(Math.random() * d0.length)];
                num1 = Math.floor(Math.random() * 45) + 5; 
                answer = num1 / num2;
                break;
            case 1:
                typeName = "🗺️ 航線 2：十分位小數 ÷ 整數";
                const d1 = [2, 4, 5, 8];
                num2 = d1[Math.floor(Math.random() * d1.length)];
                num1 = (Math.floor(Math.random() * 89) + 11) / 10;
                answer = num1 / num2;
                break;
            case 2:
                typeName = "🗺️ 航線 3：百分位小數 ÷ 整數";
                const d2 = [2, 4, 5, 8];
                num2 = d2[Math.floor(Math.random() * d2.length)];
                num1 = (Math.floor(Math.random() * 899) + 101) / 100;
                answer = num1 / num2;
                break;
            case 3:
                typeName = "🗺️ 航線 4：十分位小數 ÷ 十分位小數";
                const d3 = [0.2, 0.4, 0.5, 0.8];
                num2 = d3[Math.floor(Math.random() * d3.length)];
                num1 = (Math.floor(Math.random() * 89) + 11) / 10; 
                answer = num1 / num2;
                break;
            case 4:
                typeName = "🗺️ 航線 5：十分位小數 ÷ 百分位小數";
                const d4 = [0.02, 0.04, 0.05, 0.08, 0.16, 0.25];
                num2 = d4[Math.floor(Math.random() * d4.length)];
                num1 = (Math.floor(Math.random() * 89) + 11) / 10; 
                answer = num1 / num2;
                break;
        }

        num1 = Math.round(num1 * 100) / 100;
        num2 = Math.round(num2 * 100) / 100;
        currentAnswer = Math.round(answer * 100000) / 100000;

        document.getElementById('question-type').innerText = typeName;
        document.getElementById('question').innerText = `${num1} ÷ ${num2} = ?`;
        
        isRoundActive = true;
    }

    // 發射砲彈動畫與判定
    function fireAttack(attacker, callback) {
        const ball = document.getElementById('cannonball');
        const targetShip = document.getElementById(attacker === 1 ? 'p2-ship' : 'p1-ship');
        const explosion = document.getElementById(attacker === 1 ? 'explosion-p2' : 'explosion-p1');

        ball.className = 'cannonball';
        void ball.offsetWidth;

        if (attacker === 1) {
            ball.classList.add('fly-p1-to-p2');
        } else {
            ball.classList.add('fly-p2-to-p1');
        }

        setTimeout(() => {
            explosion.style.display = 'block';
            targetShip.classList.add('ship-hit');
            setTimeout(() => {
                explosion.style.display = 'none';
                targetShip.classList.remove('ship-hit');
                if (callback) callback();
            }, 600);
        }, 800);
    }

    function submitAnswer(player) {
        if (!isRoundActive) return;

        const inputEl = document.getElementById(player === 1 ? 'p1-input' : 'p2-input');
        const val = parseFloat(inputEl.value);
        const msg = document.getElementById('message');

        if (isNaN(val)) return;

        // 答對邏輯
        if (Math.abs(val - currentAnswer) < 0.0001) {
            isRoundActive = false;
            if (player === 1) {
                msg.style.color = "#1e40af";
                msg.innerText = `⚡ 魯夫爆發霸王色霸氣！成功發射橡膠大砲！`;
            } else {
                msg.style.color = "#991b1b";
                msg.innerText = `⚡ 凱多發動熱息大砲！重創草帽一味！`;
            }

            fireAttack(player, () => {
                if (player === 1) {
                    p2Hp--;
                    updateHpDisplay();
                } else {
                    p1Hp--;
                    updateHpDisplay();
                }

                document.getElementById('p1-input').value = '';
                document.getElementById('p2-input').value = '';

                if (p1Hp <= 0 || p2Hp <= 0) {
                    showGameOver(p1Hp > 0 ? 1 : 2);
                } else {
                    generateQuestion();
                }
            });
        } else {
            // 答錯懲罰
            const playerName = player === 1 ? '魯夫' : '凱多';
            msg.style.color = "#dc2626";
            msg.innerText = `❌ ${playerName} 算錯了！被偉大航道的大浪干擾！`;
            inputEl.value = '';
        }
    }

    function updateHpDisplay() {
        document.getElementById('p1-hp').innerText = '🍖'.repeat(Math.max(0, p1Hp)) + '🦴'.repeat(Math.max(0, 5 - p1Hp));
        document.getElementById('p2-hp').innerText = '🍖'.repeat(Math.max(0, p2Hp)) + '🦴'.repeat(Math.max(0, 5 - p2Hp));
    }

    function showGameOver(winner) {
        document.getElementById('game-screen').style.display = 'none';
        const gameOverScreen = document.getElementById('game-over-screen');
        gameOverScreen.style.display = 'block';

        const winnerTitle = document.getElementById('winner-title');
        const bountyText = document.getElementById('bounty-text');

        if (winner === 1) {
            winnerTitle.innerText = "👑 恭喜草帽魯夫登頂海賊王！";
            winnerTitle.style.color = "#1e40af";
            bountyText.innerText = "新懸賞金：฿ 3,000,000,000 貝里";
        } else {
            winnerTitle.innerText = "🐉 百獸凱多稱霸了偉大航道！";
            winnerTitle.style.color = "#991b1b";
            bountyText.innerText = "新懸賞金：฿ 4,611,100,000 貝里";
        }
    }

    function restartGame() {
        p1Hp = 5;
        p2Hp = 5;
        updateHpDisplay();

        document.getElementById('p1-input').value = '';
        document.getElementById('p2-input').value = '';
        document.getElementById('message').innerText = '';

        document.getElementById('game-screen').style.display = 'block';
        document.getElementById('game-over-screen').style.display = 'none';

        generateQuestion();
    }

    generateQuestion();
</script>

</body>
</html>
